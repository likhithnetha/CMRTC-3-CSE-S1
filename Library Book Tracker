public class Book {
    static String libName = "City Central Library";
    String title;
    int bookId;

    public static void main(String[] args) {
        int currentYear = 2025;

        Book b1 = new Book();
        b1.title = "Java Basics";
        b1.bookId = 100;

        Book b2 = new Book();
        b2.title = "Python Guide";
        b2.bookId = 101;

        System.out.println(b1.title + "\t" + b1.bookId + "\t" + currentYear);
        System.out.println(b2.title + "\t" + b2.bookId + "\t" + currentYear);
        System.out.println("Library: " + libName);
    }
}
